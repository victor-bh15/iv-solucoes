# ───────────────────────────────────────────────────────────────
# MODELO de variáveis de ambiente — NÃO coloque chaves reais aqui.
# Copie este arquivo para ".env.local" e preencha lá as suas chaves.
# O arquivo .env.local NUNCA é enviado ao GitHub (está protegido).
# ───────────────────────────────────────────────────────────────

# Chave da IA principal (DeepSeek). Pegue em https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Chave da IA reserva (Google Gemini). Pegue em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Analytics 4 (opcional). Formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Sentry — observabilidade de erros (opcional). DSN público do projeto site-iv.
# Pegue em https://iv-solucoes.sentry.io → Settings → Projects → site-iv → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
