{
  // ────────────────────────────────────────────────────────────────────────
  // Config do Cloudflare Worker (Caminho A — substituir o Vercel Hobby).
  // INERTE para a Vercel: este arquivo só é usado pelo `opennextjs-cloudflare`.
  // Ainda NÃO ativado — ver CUTOVER-CLOUDFLARE.md.
  //
  // Por que Worker e não Pages estático: o site tem a rota dinâmica /api/chat
  // (runtime nodejs). `nodejs_compat` cobre o `fetch` que ela usa p/ DeepSeek/Gemini.
  // ────────────────────────────────────────────────────────────────────────
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iv-solucoes",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "iv-solucoes"
    }
  ]
  // Segredos (NÃO commitar valores):
  //   npx wrangler secret put DEEPSEEK_API_KEY
  //   npx wrangler secret put GEMINI_API_KEY
  // Var pública (analytics), se usada:
  //   defina NEXT_PUBLIC_GA_ID em "vars" OU no build (precisa estar no bundle).
}
